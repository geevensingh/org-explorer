<Window x:Class="OrgExplorer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workflow="clr-namespace:OrgExplorer.Workflow;assembly=OrgExplorer.Workflow"
        xmlns:local="clr-namespace:OrgExplorer.Desktop"
        Title="Org explorer" Width="1100" Height="900" MinWidth="700" MinHeight="500">
  <Window.Resources>
    <Style x:Key="ReportingItem" TargetType="TreeViewItem">
      <Setter Property="AutomationProperties.AutomationId" Value="{Binding Person.Email}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Person.Heading}"/>
      <EventSetter Event="Loaded" Handler="RestoreTreeItem"/>
      <EventSetter Event="Expanded" Handler="ExpandPerson"/>
      <EventSetter Event="Collapsed" Handler="CollapsePerson"/>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type workflow:ReportingNode}" ItemsSource="{Binding Reports}"
                              ItemContainerStyle="{StaticResource ReportingItem}">
      <TextBlock Text="{Binding Person.Heading}" ToolTip="{Binding Person.Email}"/>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="140"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Private offline Workspace" FontSize="24" Margin="0,0,0,12"/>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Open Workspace" AutomationProperties.AutomationId="OpenWorkspace" Click="OpenWorkspace"/>
      <Button DockPanel.Dock="Right" Content="Choose folder…" Click="ChooseWorkspace" Margin="8,0"/>
      <TextBox x:Name="WorkspacePath" AutomationProperties.AutomationId="WorkspacePath" ToolTip="Workspace folder, separate from installation"/>
    </DockPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Preview import" AutomationProperties.AutomationId="PreviewImport" Click="PreviewImport"/>
      <Button DockPanel.Dock="Right" Content="Choose JSON…" Click="ChooseImport" Margin="8,0"/>
      <TextBox x:Name="ImportPath" AutomationProperties.AutomationId="ImportPath" ToolTip="Version-1 import JSON file"/>
    </DockPanel>
    <DockPanel Grid.Row="3" Margin="0,0,0,12">
      <Button x:Name="ApplyButton" DockPanel.Dock="Bottom" Content="Apply reviewed import" AutomationProperties.AutomationId="ApplyImport"
              IsEnabled="False" Click="ApplyImport" HorizontalAlignment="Right" Margin="0,8,0,0"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="PreviewText" AutomationProperties.AutomationId="Preview" TextWrapping="Wrap" Text="Import changes will appear here. No data changes until Apply."/>
      </ScrollViewer>
    </DockPanel>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Imported reporting population" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TreeView x:Name="PeopleList" AutomationProperties.AutomationId="People"
                  ItemContainerStyle="{StaticResource ReportingItem}" SelectedItemChanged="SelectPerson"/>
      </DockPanel>
      <ScrollViewer Grid.Column="1" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="ProfileHeading" AutomationProperties.AutomationId="ProfileHeading" FontSize="24"/>
        <local:PersonPhotoControl x:Name="Photo"/>
        <TextBlock x:Name="DirectoryName" AutomationProperties.AutomationId="DirectoryName"/>
        <TextBlock x:Name="Email" AutomationProperties.AutomationId="Email" Margin="0,8" ToolTip="Stable email identity; not editable"/>
        <Button x:Name="Manager" AutomationProperties.AutomationId="NavigateManager" Click="NavigateManager"
                HorizontalAlignment="Left" Margin="0,12" IsEnabled="False"/>
        <TextBlock x:Name="ReportCount" Text="Imported reports (not a full-company count)" TextWrapping="Wrap"/>
        <ListBox x:Name="ReportsList" AutomationProperties.AutomationId="ImportedReports" DisplayMemberPath="Heading"
                 SelectionChanged="NavigateReport" MaxHeight="110" Margin="0,4,0,12"/>
        <TextBlock Text="Saved locally as you type. Empty clears; whitespace alone is invalid."
                   TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>
        <StackPanel x:Name="AttributeEditors" IsEnabled="False">
          <TextBlock Text="Directory name" Margin="0,8,0,4"/>
          <TextBox x:Name="DirectoryNameEditor" Tag="DirectoryName" AutomationProperties.AutomationId="DirectoryNameEditor"
                   AutomationProperties.Name="Directory name" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Preferred name" Margin="0,8,0,4"/>
          <TextBox x:Name="PreferredName" Tag="PreferredName" AutomationProperties.AutomationId="PreferredName"
                   AutomationProperties.Name="Preferred name" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Alias (short company handle)" Margin="0,8,0,4"/>
          <TextBox x:Name="Alias" Tag="Alias" AutomationProperties.AutomationId="Alias"
                   AutomationProperties.Name="Alias" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Job title" Margin="0,8,0,4"/>
          <TextBox x:Name="JobTitle" Tag="JobTitle" AutomationProperties.AutomationId="JobTitle"
                   AutomationProperties.Name="Job title" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Department" Margin="0,8,0,4"/>
          <TextBox x:Name="Department" Tag="Department" AutomationProperties.AutomationId="Department"
                   AutomationProperties.Name="Department" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Office building (text)" Margin="0,8,0,4"/>
          <TextBox x:Name="OfficeBuilding" Tag="OfficeBuilding" AutomationProperties.AutomationId="OfficeBuilding"
                   AutomationProperties.Name="Office building" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Office number (text)" Margin="0,8,0,4"/>
          <TextBox x:Name="OfficeNumber" Tag="OfficeNumber" AutomationProperties.AutomationId="OfficeNumber"
                   AutomationProperties.Name="Office number" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Office state / province" Margin="0,8,0,4"/>
          <TextBox x:Name="OfficeState" Tag="OfficeState" AutomationProperties.AutomationId="OfficeState"
                   AutomationProperties.Name="Office state" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="Office country" Margin="0,8,0,4"/>
          <TextBox x:Name="OfficeCountry" Tag="OfficeCountry" AutomationProperties.AutomationId="OfficeCountry"
                   AutomationProperties.Name="Office country" TextChanged="EditPersonAttribute"/>
          <TextBlock Text="LinkedIn profile URL (HTTPS; never fetched automatically)" TextWrapping="Wrap" Margin="0,8,0,4"/>
          <TextBox x:Name="LinkedInProfileUrl" Tag="LinkedInProfileUrl" AutomationProperties.AutomationId="LinkedInProfileUrl"
                   AutomationProperties.Name="LinkedIn profile URL" TextChanged="EditPersonAttribute"/>
          <Button x:Name="OpenLinkedInButton" Content="Open saved LinkedIn URL in browser" IsEnabled="False"
                  AutomationProperties.AutomationId="OpenLinkedIn" Click="OpenLinkedIn" HorizontalAlignment="Left" Margin="0,8"/>
        </StackPanel>
        <local:PersonNotesControl x:Name="PersonNotes" Margin="0,16,0,0"/>
      </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="5" AutomationProperties.AutomationId="Status" TextWrapping="Wrap" Margin="0,16,0,0" Text="Choose a Workspace."/>
  </Grid>
</Window>
