<Window x:Class="OrgExplorer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workflow="clr-namespace:OrgExplorer.Workflow;assembly=OrgExplorer.Workflow"
        xmlns:local="clr-namespace:OrgExplorer.Desktop"
        Title="Org explorer" Width="1100" Height="900" MinWidth="700" MinHeight="500"
        AutomationProperties.ItemStatus="{Binding Text, ElementName=WorkflowActivity}"
        AutomationProperties.HelpText="{Binding Text, ElementName=StatusText}"
        Icon="/OrgExplorer.Desktop;component/Assets/OrgExplorer.ico"
        FontFamily="Segoe UI" FontSize="14" Background="#FAFBFC" Foreground="#24292F">
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static local:MainWindow.CollapseSubtreeCommand}"
                    CanExecute="CanCollapseSubtree" Executed="CollapseSubtree"/>
    <CommandBinding Command="{x:Static local:MainWindow.CollapseOtherBranchesCommand}"
                    CanExecute="CanCollapseOtherBranches" Executed="CollapseOtherBranches"/>
  </Window.CommandBindings>
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#0969DA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#576B82"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#DCE5EF"/>
    <SolidColorBrush x:Key="SearchMatchBrush" Color="#DDEEFF"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#EAF3FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#D8E9FC"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#738294"/>
                <Setter TargetName="Chrome" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#0550AE"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#033D8B"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#24292F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="MinWidth" Value="30"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="FlowDocumentScrollViewer">
      <Setter Property="MaxWidth" Value="600"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="IsToolBarVisible" Value="False"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="ReadingSection" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,16,0,4"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
    <Style x:Key="ReadingHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ReadingProse" TargetType="TextBlock">
      <Setter Property="MaxWidth" Value="600"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style x:Key="NoteMetadata" TargetType="TextBlock" BasedOn="{StaticResource ReadingProse}">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="ReadingDisclosure" TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,8,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            HorizontalContentAlignment="Stretch">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderChrome" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4"
                            Background="Transparent" Padding="0,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 0,8"
                              Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                              Width="6" Height="10" Stretch="Uniform" Margin="12,0,4,0"
                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Arrow" Property="RenderTransform">
                          <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="HeaderChrome" Property="Background" Value="#EAF3FF"/>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="HeaderChrome" Property="Opacity" Value="0.65"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="DisclosureBody" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="DisclosureBody" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NoteModeTab" TargetType="TabItem">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock x:Name="HeaderLabel" Text="{Binding}"/>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                <Setter TargetName="HeaderLabel" Property="Foreground" Value="{StaticResource AccentBrush}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#EAF3FF"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="OtherNoteItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
      <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#EAF3FF"/>
          <Setter Property="Foreground" Value="#24292F"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="FactSlot" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,4,16,8"/>
    </Style>
    <Style x:Key="FactLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style TargetType="local:ProfileCopyText">
      <EventSetter Event="CopyRequested" Handler="CopyProfileValue"/>
      <Setter Property="ToolTip" Value="{Binding CopyHint, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style x:Key="NavigationRow" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F5FB"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#E2EEFD"/>
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ProfileField" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,16,12"/>
    </Style>
    <Style x:Key="ReportingItem" TargetType="TreeViewItem">
      <Setter Property="AutomationProperties.AutomationId" Value="{Binding Person.Email}"/>
      <Setter Property="AutomationProperties.Name">
        <Setter.Value>
          <MultiBinding StringFormat="{}{0} ({1}); Directory name: {2}">
            <Binding Path="Person.Heading"/><Binding Path="Person.Email"/><Binding Path="Person.DirectoryName"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <EventSetter Event="Loaded" Handler="RestoreTreeItem"/>
      <EventSetter Event="Expanded" Handler="ExpandPerson"/>
      <EventSetter Event="Collapsed" Handler="CollapsePerson"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="TargetReportingMenu"/>
      <EventSetter Event="ContextMenuOpening" Handler="PrepareReportingMenu"/>
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu>
            <ContextMenu.Resources>
              <Style TargetType="MenuItem">
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ContextMenu.Resources>
            <ContextMenu.Style>
              <Style TargetType="ContextMenu">
                <EventSetter Event="Closed" Handler="CloseReportingMenu"/>
              </Style>
            </ContextMenu.Style>
            <MenuItem Header="Collapse subtree" AutomationProperties.AutomationId="CollapseSubtree"
                      Command="{x:Static local:MainWindow.CollapseSubtreeCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Person.Email, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Collapse other branches" AutomationProperties.AutomationId="CollapseOtherBranches"
                      Command="{x:Static local:MainWindow.CollapseOtherBranchesCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Person.Email, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
          </ContextMenu>
        </Setter.Value>
      </Setter>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border x:Name="Row" Grid.ColumnSpan="2" MinHeight="28" CornerRadius="3"
                      BorderThickness="2,0,0,0" BorderBrush="Transparent" Background="Transparent">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="22,4,8,4"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </Border>
              <ToggleButton x:Name="Expander" Width="18" Height="28" Focusable="False" HorizontalAlignment="Left"
                            AutomationProperties.Name="Expand or collapse reporting subtree"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                      <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 0 8" Stroke="#576B82" StrokeThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Border Grid.Row="1" BorderBrush="#CEDCEC" BorderThickness="1,0,0,0" Margin="9,0,0,0"/>
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#F0F5FB"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#E2EEFD"/>
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Row" Property="Opacity" Value=".6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ReportingRootItem" TargetType="TreeViewItem" BasedOn="{StaticResource ReportingItem}">
      <Setter Property="MinWidth"
              Value="{Binding DataContext.PeopleNavigation.BrowseExtentWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, FallbackValue=0}"/>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type workflow:ReportingNode}" ItemsSource="{Binding Reports}"
                              ItemContainerStyle="{StaticResource ReportingItem}">
      <TextBlock Text="{Binding Person.Heading}" MaxHeight="20"/>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <Button x:Name="OpenSettingsButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"
                AutomationProperties.AutomationId="OpenSettings" AutomationProperties.Name="Settings"
                Click="ToggleSettings" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <AccessText Text="_Settings"/>
          </StackPanel>
        </Button>
        <Button x:Name="OpenPeopleButton" DockPanel.Dock="Left" Content="_People" Visibility="Collapsed"
                AutomationProperties.AutomationId="OpenPeople" AutomationProperties.Name="People"
                Click="TogglePeople" Margin="0,0,12,0"/>
        <TextBlock x:Name="WorkspaceName" AutomationProperties.AutomationId="WorkspaceName" Text="No Workspace open"
                   AutomationProperties.ItemStatus="{Binding Text, ElementName=WorkspaceFreshness}"
                   Foreground="DimGray" MaxWidth="150" Margin="0,0,16,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <Grid Margin="0,0,16,0">
          <TextBox x:Name="SearchQuery" AutomationProperties.AutomationId="SearchQuery" AutomationProperties.Name="Local search"
                   Padding="32,6,36,6" VerticalContentAlignment="Center"
                   TextChanged="ChangeSearchQuery" PreviewKeyDown="ConfirmSearchQuery"
                   ToolTip="Search profiles and private notes, including archived and historical context"/>
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0" IsHitTestVisible="False"/>
          <TextBlock Text="Search here..." Foreground="{StaticResource MutedBrush}" Margin="32,0,36,0"
                     VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchQuery}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button x:Name="ClearSearchButton" Content="&#xE711;" HorizontalAlignment="Right" Margin="2"
                  AutomationProperties.AutomationId="ClearSearch" AutomationProperties.Name="Clear local search"
                  Click="ClearSearch" ToolTip="Clear search and return to browsing">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchQuery}" Value="">
                    <Setter Property="Visibility" Value="Hidden"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>
      </DockPanel>
      <TextBlock x:Name="UpdateSummary" AutomationProperties.AutomationId="UpdateSummary"
                 TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>
      <TextBlock x:Name="ViewPreferenceStatus" AutomationProperties.AutomationId="ViewPreferenceStatus"
                 TextWrapping="Wrap" Foreground="#8A3B12" Visibility="Collapsed" Margin="0,0,0,8"/>
      <TextBlock x:Name="PanePreferenceStatus" AutomationProperties.AutomationId="PanePreferenceStatus"
                 TextWrapping="Wrap" Foreground="#8A3B12" Visibility="Collapsed" Margin="0,0,0,8"/>
      <StackPanel x:Name="WorkspaceStartupPanel" Visibility="Collapsed" Margin="0,0,0,12">
        <TextBlock x:Name="WorkspaceStartupStatus" AutomationProperties.AutomationId="WorkspaceStartupStatus"
                   TextWrapping="Wrap"/>
        <WrapPanel Margin="0,8,0,0">
          <Button x:Name="RetryStartupWorkspaceButton" Content="Retry previous Workspace"
                  AutomationProperties.AutomationId="RetryStartupWorkspace" Click="RetryStartupWorkspace" Margin="0,0,12,0"/>
          <Button Content="Choose another folder..." AutomationProperties.AutomationId="ChooseAnotherWorkspace"
                  Click="ChooseAnotherWorkspace"/>
        </WrapPanel>
      </StackPanel>
    </StackPanel>
    <Border x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0"
            Background="White" Padding="12">
      <DockPanel>
        <TextBlock x:Name="SettingsTitle" DockPanel.Dock="Top" Text="Settings" FontSize="28" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="SettingsTitle"/>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="840" HorizontalAlignment="Left">
            <TextBlock Text="Workspace" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/>
            <TextBlock x:Name="WorkspacePathLabel" Text="Current Workspace folder"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="WorkspacePath" AutomationProperties.AutomationId="WorkspacePath"
                       AutomationProperties.Name="No Workspace open" Text="No Workspace open"
                       TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                       ToolTip="Current Workspace folder. Use the context menu to copy its full path.">
              <TextBlock.ContextMenu>
                <ContextMenu><MenuItem Header="Copy path"
                    Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    Click="CopyProfileValue"/></ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
            <WrapPanel x:Name="WorkspaceControls" Margin="0,16,0,24">
              <Button x:Name="OpenWorkspaceButton" Content="_Open Workspace..."
                      Style="{StaticResource PrimaryButton}"
                      AutomationProperties.AutomationId="OpenWorkspace" AutomationProperties.Name="Open Workspace..."
                      Click="OpenWorkspace"/>
              <Button x:Name="CreateLocalSqliteWorkspaceButton" Content="Create new local Workspace"
                      AutomationProperties.AutomationId="CreateLocalSqliteWorkspace"
                      Click="CreateLocalSqliteWorkspace"/>
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Workspaces save to local SQLite storage outside synchronized folders. Configure a separate synchronization folder below to exchange complete snapshots. Older readable-file Workspaces are unsupported: preserve the old folder and create a new Workspace; no migration is performed."/>
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
            <TextBlock Text="Import" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <TextBlock Text="Review the proposed changes before applying them." TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"/>
            <Button x:Name="OpenImportButton" Content="_Import..." AutomationProperties.AutomationId="OpenImport"
                    Click="OpenImportView" HorizontalAlignment="Left" Margin="0,16,0,24"/>
            <StackPanel x:Name="SynchronizationPanel" Visibility="Collapsed" Margin="0,0,0,24">
              <TextBlock Text="Synchronization" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,8"/>
              <TextBlock Text="Choose a separate folder carried by your existing provider. Only complete logical snapshots are exchanged, never the live local database. Use computers one at a time."
                         TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="SynchronizationFolder" AutomationProperties.AutomationId="SynchronizationFolder"
                         TextWrapping="Wrap" Focusable="True" Margin="0,8,0,8">
                <TextBlock.ContextMenu>
                  <ContextMenu><MenuItem Header="Copy path"
                      Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="CopyProfileValue"/></ContextMenu>
                </TextBlock.ContextMenu>
              </TextBlock>
              <WrapPanel>
                <Button x:Name="ConfigureSynchronizationFolderButton" Content="Configure folder..."
                        AutomationProperties.AutomationId="ConfigureSynchronizationFolder" Click="ConfigureSynchronizationFolder"/>
                <Button x:Name="JoinSynchronizationFolderButton" Content="Join folder (empty local Workspace)..."
                        AutomationProperties.AutomationId="JoinSynchronizationFolder" Click="JoinSynchronizationFolder"/>
                <Button x:Name="SyncNowButton" Content="Sync now" AutomationProperties.AutomationId="SyncNow"
                        Click="SynchronizeNow"/>
              </WrapPanel>
              <TextBlock x:Name="SynchronizationStatus" AutomationProperties.AutomationId="SynchronizationStatus"
                         TextWrapping="Wrap" Margin="0,8,0,0"/>
              <Button x:Name="ReviewWorkspaceVersionsButton" Content="Review complete versions / retained recovery"
                      AutomationProperties.AutomationId="ReviewWorkspaceVersions" Click="ReviewWorkspaceVersions"
