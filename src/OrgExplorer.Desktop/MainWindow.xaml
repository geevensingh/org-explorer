<Window x:Class="OrgExplorer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workflow="clr-namespace:OrgExplorer.Workflow;assembly=OrgExplorer.Workflow"
        xmlns:local="clr-namespace:OrgExplorer.Desktop"
        Title="Org explorer" Width="1100" Height="900" MinWidth="700" MinHeight="500"
        AutomationProperties.ItemStatus="{Binding Text, ElementName=WorkflowActivity}"
        AutomationProperties.HelpText="{Binding Text, ElementName=StatusText}"
        Icon="/OrgExplorer.Desktop;component/Assets/OrgExplorer.ico"
        FontFamily="Segoe UI" FontSize="14" Background="#FAFBFC" Foreground="#24292F">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#0969DA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#576B82"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#DCE5EF"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#EAF3FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#D8E9FC"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#738294"/>
                <Setter TargetName="Chrome" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#0550AE"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#033D8B"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#24292F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="MinWidth" Value="30"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="FlowDocumentScrollViewer">
      <Setter Property="MaxWidth" Value="600"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="IsToolBarVisible" Value="False"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="FactSlot" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,8,16,12"/>
    </Style>
    <Style x:Key="FactLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="ProfileField" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,16,12"/>
    </Style>
    <Style x:Key="ReportingItem" TargetType="TreeViewItem">
      <Setter Property="AutomationProperties.AutomationId" Value="{Binding Person.Email}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Person.Heading}"/>
      <EventSetter Event="Loaded" Handler="RestoreTreeItem"/>
      <EventSetter Event="Expanded" Handler="ExpandPerson"/>
      <EventSetter Event="Collapsed" Handler="CollapsePerson"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style x:Key="ReportingRootItem" TargetType="TreeViewItem" BasedOn="{StaticResource ReportingItem}">
      <Setter Property="MinWidth"
              Value="{Binding DataContext.PeopleNavigation.BrowseExtentWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, FallbackValue=0}"/>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type workflow:ReportingNode}" ItemsSource="{Binding Reports}"
                              ItemContainerStyle="{StaticResource ReportingItem}">
      <TextBlock Text="{Binding Person.Heading}" ToolTip="{Binding Person.Email}"/>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <Button x:Name="OpenSettingsButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"
                AutomationProperties.AutomationId="OpenSettings" AutomationProperties.Name="Settings"
                Click="ToggleSettings" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <AccessText Text="_Settings"/>
          </StackPanel>
        </Button>
        <Button x:Name="OpenPeopleButton" DockPanel.Dock="Left" Content="_People" Visibility="Collapsed"
                AutomationProperties.AutomationId="OpenPeople" AutomationProperties.Name="People"
                Click="TogglePeople" Margin="0,0,12,0"/>
        <TextBlock x:Name="WorkspaceName" AutomationProperties.AutomationId="WorkspaceName" Text="No Workspace open"
                   AutomationProperties.ItemStatus="{Binding Text, ElementName=WorkspaceFreshness}"
                   Foreground="DimGray" MaxWidth="150" Margin="0,0,16,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <Grid Margin="0,0,16,0">
          <TextBox x:Name="SearchQuery" AutomationProperties.AutomationId="SearchQuery" AutomationProperties.Name="Local search"
                   Padding="32,6,36,6" VerticalContentAlignment="Center"
                   TextChanged="ChangeSearchQuery" ToolTip="Search profiles and private notes, including archived and historical context"/>
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0" IsHitTestVisible="False"/>
          <TextBlock Text="Search here..." Foreground="{StaticResource MutedBrush}" Margin="32,0,36,0"
                     VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchQuery}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button x:Name="ClearSearchButton" Content="&#xE711;" HorizontalAlignment="Right" Margin="2"
                  AutomationProperties.AutomationId="ClearSearch" AutomationProperties.Name="Clear local search"
                  Click="ClearSearch" ToolTip="Clear search and return to browsing">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchQuery}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>
      </DockPanel>
      <TextBlock x:Name="UpdateSummary" AutomationProperties.AutomationId="UpdateSummary"
                 TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>
      <TextBlock x:Name="ViewPreferenceStatus" AutomationProperties.AutomationId="ViewPreferenceStatus"
                 TextWrapping="Wrap" Foreground="#8A3B12" Visibility="Collapsed" Margin="0,0,0,8"/>
      <TextBlock x:Name="PanePreferenceStatus" AutomationProperties.AutomationId="PanePreferenceStatus"
                 TextWrapping="Wrap" Foreground="#8A3B12" Visibility="Collapsed" Margin="0,0,0,8"/>
      <StackPanel x:Name="WorkspaceStartupPanel" Visibility="Collapsed" Margin="0,0,0,12">
        <TextBlock x:Name="WorkspaceStartupStatus" AutomationProperties.AutomationId="WorkspaceStartupStatus"
                   TextWrapping="Wrap"/>
        <WrapPanel Margin="0,8,0,0">
          <Button x:Name="RetryStartupWorkspaceButton" Content="Retry previous Workspace"
                  AutomationProperties.AutomationId="RetryStartupWorkspace" Click="RetryStartupWorkspace" Margin="0,0,12,0"/>
          <Button Content="Choose another folder..." AutomationProperties.AutomationId="ChooseAnotherWorkspace"
                  Click="ChooseAnotherWorkspace"/>
        </WrapPanel>
      </StackPanel>
    </StackPanel>
    <Border x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0"
            Background="White" Padding="12">
      <DockPanel>
        <TextBlock x:Name="SettingsTitle" DockPanel.Dock="Top" Text="Settings" FontSize="28" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="SettingsTitle"/>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="840" HorizontalAlignment="Left">
            <TextBlock Text="Workspace" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/>
            <TextBlock x:Name="WorkspacePathLabel" Text="Current Workspace folder"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="WorkspacePath" AutomationProperties.AutomationId="WorkspacePath"
                       AutomationProperties.Name="No Workspace open" Text="No Workspace open"
                       TextWrapping="Wrap" Focusable="True" KeyboardNavigation.IsTabStop="True"
                       ToolTip="Current Workspace folder. Use the context menu to copy its full path.">
              <TextBlock.ContextMenu>
                <ContextMenu><MenuItem Header="Copy path"
                    Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                    Click="CopyProfileValue"/></ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
            <WrapPanel x:Name="WorkspaceControls" Margin="0,16,0,24">
              <Button x:Name="OpenWorkspaceButton" Content="_Open Workspace..."
                      AutomationProperties.AutomationId="OpenWorkspace" AutomationProperties.Name="Open Workspace..."
                      Click="OpenWorkspace"/>
            </WrapPanel>
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
            <TextBlock Text="Import" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <TextBlock Text="Review the proposed changes before applying them." TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"/>
            <Button x:Name="OpenImportButton" Content="_Import..." AutomationProperties.AutomationId="OpenImport"
                    Click="OpenImportView" HorizontalAlignment="Left" Margin="0,16,0,24"/>
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
            <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <WrapPanel Margin="0,8,0,12">
              <Button x:Name="CheckForUpdatesButton" Content="Check for updates" AutomationProperties.AutomationId="CheckForUpdates"
                      Click="CheckForUpdates" Margin="0,0,12,0"/>
            </WrapPanel>
            <StackPanel Margin="0,0,0,24">
              <CheckBox x:Name="StartupUpdateChecks" Content="Check for updates on startup" IsChecked="True"
                        AutomationProperties.AutomationId="StartupUpdateChecks" VerticalAlignment="Center"
                        Checked="ChangeStartupUpdateChecks" Unchecked="ChangeStartupUpdateChecks"/>
            </StackPanel>
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"/>
            <Expander x:Name="TechnicalDetails" Header="Compatibility, recovery and technical details"
                      AutomationProperties.AutomationId="TechnicalDetails" IsExpanded="False" Margin="0,20,0,12">
              <StackPanel Margin="0,12,0,0">
                <TextBlock x:Name="SettingsGuidance" AutomationProperties.AutomationId="SettingsGuidance" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button x:Name="RetryWorkspaceButton" Content="Retry Workspace validation / storage maintenance"
                        AutomationProperties.AutomationId="RetryWorkspace" Click="RetryWorkspace" HorizontalAlignment="Left"/>
                <TextBlock x:Name="PublicationConflictDetails" AutomationProperties.AutomationId="PublicationConflictDetails"
                           TextWrapping="Wrap" Margin="0,8"/>
                <WrapPanel>
                  <Button x:Name="ReviewPublicationConflictsButton" Content="Review publication conflicts"
                          AutomationProperties.AutomationId="ReviewPublicationConflicts" Click="ReviewPublicationConflicts"/>
                  <Button x:Name="ResolvePublicationConflictsButton" Content="Acknowledge external resolution"
                          AutomationProperties.AutomationId="ResolvePublicationConflicts" Click="ResolvePublicationConflicts" Margin="8,0"/>
                </WrapPanel>
                <TextBlock x:Name="StartupUpdateStatus" AutomationProperties.AutomationId="StartupUpdateStatus" TextWrapping="Wrap" Margin="0,16,0,8"/>
                <TextBlock x:Name="UpdateGuidance" AutomationProperties.AutomationId="UpdateGuidance" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Authorized updates download automatically and restart only after local saves and Import application finish. Failed writing blocks restart. Project-key authorization is not Windows publisher verification and does not remove installer warnings."
                           TextWrapping="Wrap"/>
                <TextBlock Text="Installer rollback does not restore Workspace data. Preserve the entire Workspace and recoverable originals before resolving files externally."
                           TextWrapping="Wrap" Margin="0,8"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid x:Name="ImportPanel" Grid.Row="2" Visibility="Collapsed" AutomationProperties.AutomationId="ImportView">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Content="Back to people" AutomationProperties.AutomationId="BackToPeople"
                Click="ShowPeopleView"/>
        <TextBlock Text="Import — review explicit Person updates" FontSize="24"/>
      </DockPanel>
      <DockPanel x:Name="ImportControls" Grid.Row="1" Margin="0,0,0,8">
        <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="Preview import" AutomationProperties.AutomationId="PreviewImport" Click="PreviewImport"/>
        <Button DockPanel.Dock="Right" Content="Choose JSON…" AutomationProperties.AutomationId="ChooseImportFile" Click="ChooseImport" Margin="8,0"/>
        <TextBox x:Name="ImportPath" AutomationProperties.AutomationId="ImportPath" ToolTip="Version-1 import JSON file"
                 TextChanged="ChangeImportPath" KeyDown="ConfirmImportPath"/>
      </DockPanel>
      <DockPanel x:Name="ImportPreviewPanel" Grid.Row="2" Margin="0,0,0,12">
        <Button x:Name="ApplyButton" DockPanel.Dock="Bottom" Content="Apply reviewed import" AutomationProperties.AutomationId="ApplyImport"
                IsEnabled="False" Click="ApplyImport" HorizontalAlignment="Right" Margin="0,8,0,0"/>
        <TextBlock DockPanel.Dock="Top" Text="Reviewed changes — no data changes until Apply." Margin="0,0,0,4"/>
        <ListBox x:Name="PreviewText" AutomationProperties.AutomationId="Preview"
                 AutomationProperties.Name="Import changes will appear here. No data changes until Apply."
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
    <GroupBox x:Name="WorkspaceSurface" Grid.Row="2"
              AutomationProperties.AutomationId="AdaptiveWorkspace" AutomationProperties.Name="Adaptive Person workspace">
      <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate></GroupBox.Template>
    <Grid x:Name="ExplorerPanel" SizeChanged="ResizeWorkspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PeopleColumn" Width="25*"/>
        <ColumnDefinition x:Name="PeopleDividerColumn" Width="8"/>
        <ColumnDefinition Width="75*"/>
      </Grid.ColumnDefinitions>
      <GroupBox x:Name="PeoplePanel" Header="People" BorderThickness="0" Padding="0" Background="#FAFBFC"
                AutomationProperties.AutomationId="PeopleNavigation">
      <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button x:Name="ClosePeopleButton" Content="Close People" HorizontalAlignment="Right"
                AutomationProperties.AutomationId="ClosePeople" Click="ClosePeople" Visibility="Collapsed" Margin="0,0,0,8"/>
        <DockPanel x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed">
          <TextBlock DockPanel.Dock="Top" x:Name="SearchCount" AutomationProperties.AutomationId="SearchCount"
                     Text="Enter text to search local information." TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ListBox x:Name="SearchResults" AutomationProperties.AutomationId="SearchResults" AutomationProperties.Name="Local search results"
                   SelectionChanged="SelectSearchResult" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding MatchText}" TextTrimming="CharacterEllipsis" Foreground="DimGray" MaxHeight="20"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <DockPanel x:Name="BrowsingPanel" Grid.Row="1">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBlock x:Name="FavoriteCount" AutomationProperties.AutomationId="FavoriteCount" Text="Favorites: 0" FontWeight="SemiBold" Margin="0,8,0,4"/>
          <ListBox x:Name="FavoritesList" AutomationProperties.AutomationId="Favorites" AutomationProperties.Name="Favorites" MaxHeight="90"
                   DisplayMemberPath="Label" SelectionChanged="SelectFavoritePerson">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Person.Email}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Imported reporting population" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <CheckBox x:Name="ShowArchivedPeople" DockPanel.Dock="Top" Content="Show archived people"
                  AutomationProperties.AutomationId="ShowArchivedPeople" Margin="0,0,0,8"
                  Checked="ChangeArchivedFilter" Unchecked="ChangeArchivedFilter"/>
        <StackPanel x:Name="ArchivedPeoplePanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,12,0,0">
          <TextBlock x:Name="ArchivedPeopleCount" Text="Archived profiles — retained, not current org" TextWrapping="Wrap"/>
          <ListBox x:Name="ArchivedPeopleList" AutomationProperties.AutomationId="ArchivedPeople"
                   DisplayMemberPath="Heading" SelectionChanged="SelectArchivedPerson" MaxHeight="220" Margin="0,8,0,0">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Email}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Heading}"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </StackPanel>
        <TreeView x:Name="PeopleList" AutomationProperties.AutomationId="People" AutomationProperties.Name="Imported reporting population"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ItemContainerStyle="{StaticResource ReportingRootItem}" SelectedItemChanged="SelectPerson"/>
        </DockPanel>
      </Grid>
      </GroupBox>
      <GridSplitter x:Name="PeopleDivider" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                    Background="#EAECEF" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    Focusable="True" KeyboardIncrement="10" DragStarted="BeginPaneResize" DragCompleted="SavePaneBalance"
                    PreviewKeyDown="ResizePaneWithKeyboard"
                    AutomationProperties.AutomationId="PeopleDivider" AutomationProperties.Name="Resize People and Person workspace"/>
      <Grid x:Name="PersonWorkspace" Grid.Column="2" Margin="12,0,0,0" Background="White">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="PersonIdentity" Visibility="Collapsed" Margin="0,8,12,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <local:PersonPhotoControl x:Name="Photo" Grid.RowSpan="2" Margin="0,0,16,0" VerticalAlignment="Top"/>
          <StackPanel Grid.Column="1">
            <DockPanel HorizontalAlignment="Left">
              <StackPanel x:Name="PreferredNameContext" DockPanel.Dock="Right" IsEnabled="False">
                <WrapPanel x:Name="PreferredNameReadPanel">
                  <Button x:Name="EditPreferredNameButton" Content="&#xE70F;" Style="{StaticResource IconButton}"
                          AutomationProperties.AutomationId="EditPreferredName" AutomationProperties.Name="Add preferred name"
                          ToolTip="Add preferred name" Click="EditPreferredName"/>
                </WrapPanel>
              </StackPanel>
              <TextBlock x:Name="ProfileHeading" AutomationProperties.AutomationId="ProfileHeading" FontSize="24"
                         FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="64" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel x:Name="JobTitleValueRow" Visibility="Collapsed" Margin="0,0,12,0">
                <TextBlock x:Name="JobTitleValue" TextWrapping="Wrap" AutomationProperties.AutomationId="JobTitleValue"
                           MaxHeight="44"
                           Foreground="{StaticResource MutedBrush}" Focusable="True" KeyboardNavigation.IsTabStop="True">
                  <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
                </TextBlock>
              </StackPanel>
              <StackPanel x:Name="DepartmentValueRow" Grid.Column="1" Visibility="Collapsed">
                <TextBlock x:Name="DepartmentValue" TextWrapping="Wrap" AutomationProperties.AutomationId="DepartmentValue"
                           MaxHeight="44"
                           Foreground="{StaticResource MutedBrush}" Focusable="True" KeyboardNavigation.IsTabStop="True">
                  <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
                </TextBlock>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="Email" AutomationProperties.AutomationId="Email" TextWrapping="Wrap" MaxHeight="44"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
            <TextBlock x:Name="PersonArchivalStatus" AutomationProperties.AutomationId="PersonArchivalStatus"
                       Visibility="Collapsed" TextWrapping="Wrap" Foreground="#8A3B12" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <Popup x:Name="PreferredNamePopup" PlacementTarget="{Binding ElementName=EditPreferredNameButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="PreferredNameDismissed">
              <Border x:Name="PreferredNameEditorPanel" Visibility="Collapsed" Width="320" Padding="16"
                      Background="White" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="6"
                      KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="PreferredNameKeyDown">
                <GroupBox Header="Preferred name" Padding="0" BorderThickness="0"
                          AutomationProperties.AutomationId="PreferredNameEntry" AutomationProperties.Name="Preferred name entry">
                  <StackPanel>
                    <TextBox x:Name="PreferredName" Tag="PreferredName" Margin="0,8,0,0"
                             AutomationProperties.AutomationId="PreferredName" AutomationProperties.Name="Preferred name"
                             TextChanged="EditPersonAttribute"/>
                    <TextBlock Text="Empty clears the preferred name." Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8"/>
                    <ScrollViewer MaxHeight="140" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <TextBlock x:Name="PreferredNameError" AutomationProperties.AutomationId="PreferredNameError"
                                 Foreground="#A4262C" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"
                                 AutomationProperties.LiveSetting="Assertive"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="SavePreferredNameButton" Content="Save" MinWidth="80" Style="{StaticResource PrimaryButton}"
                              AutomationProperties.AutomationId="SavePreferredName" Click="SavePreferredName"/>
                      <Button x:Name="CancelPreferredNameButton" Content="Cancel" Margin="8,0,0,0"
                              AutomationProperties.AutomationId="CancelPreferredName" Click="CancelPreferredName"/>
                    </StackPanel>
                  </StackPanel>
                </GroupBox>
              </Border>
            </Popup>
          </StackPanel>
          <StackPanel x:Name="IdentityActions" Grid.Column="2" VerticalAlignment="Top">
            <WrapPanel>
              <Button x:Name="FavoriteButton" Content="&#xE734;" Style="{StaticResource IconButton}"
                      AutomationProperties.AutomationId="ToggleFavorite" AutomationProperties.Name="Mark favorite"
                      Click="ChangeFavorite" IsEnabled="False" Margin="0,0,4,0"/>
              <Button x:Name="EditProfileButton" Content="Edit profile" Style="{StaticResource QuietButton}"
                      AutomationProperties.AutomationId="EditProfile" Click="BeginProfileEdit" IsEnabled="False"/>
              <Menu VerticalAlignment="Center" Margin="4,0" Background="Transparent">
                <MenuItem x:Name="PersonMoreMenu" Header="More" AutomationProperties.AutomationId="PersonMore" IsEnabled="False">
                  <MenuItem x:Name="ArchivePersonMenuItem" Header="Archive Person…" AutomationProperties.AutomationId="ArchivePerson" Click="ArchivePerson"/>
                  <MenuItem x:Name="ReactivatePersonMenuItem" Header="Reactivate Person…" AutomationProperties.AutomationId="ReactivatePerson"
                            Click="ReactivatePerson" Visibility="Collapsed"/>
                </MenuItem>
              </Menu>
            </WrapPanel>
            <TextBlock x:Name="FavoriteStatus" AutomationProperties.AutomationId="FavoriteStatus"
                       Visibility="Collapsed" Foreground="#8A3B12" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Border x:Name="ProfileSessionActions" Grid.Row="1" Visibility="Collapsed" Margin="0,0,12,12"
                Background="#EAF3FF" CornerRadius="4" Padding="10,8">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
              <Button x:Name="CancelProfileButton" Content="Cancel" AutomationProperties.AutomationId="CancelProfile"
                      Click="CancelProfileEdit" Margin="0,0,8,0"/>
              <Button x:Name="SaveProfileButton" Content="Save profile" Style="{StaticResource PrimaryButton}"
                      AutomationProperties.AutomationId="SaveProfile" Click="SaveProfileEdit"/>
            </StackPanel>
            <TextBlock Text="Editing profile" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="ProfileEditingState"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
      <ScrollViewer x:Name="PersonScroll" Grid.Row="2" AutomationProperties.AutomationId="ProfileScroll"
                    VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <GroupBox x:Name="WorkspaceStartPanel" Margin="0,12" BorderThickness="0" Padding="0"
                  AutomationProperties.AutomationId="WorkspaceStart" AutomationProperties.Name="Find a Person">
          <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate></GroupBox.Template>
          <StackPanel>
          <TextBlock Text="Find a Person" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="WorkspaceStartGuidance" AutomationProperties.AutomationId="WorkspaceStartGuidance"
                     Text="Open Settings to choose a Workspace, or use the recovery actions above."
                     TextWrapping="Wrap" Margin="0,8"/>
          <Button Content="Search / browse People" Click="FindPersonFromStart"
                  AutomationProperties.AutomationId="FindPerson" HorizontalAlignment="Left"/>
          </StackPanel>
        </GroupBox>
        <Grid x:Name="PersonBody" Visibility="Collapsed" SizeChanged="ResizePersonBody">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <GroupBox x:Name="ProfileSummary" BorderThickness="0" Padding="0"
                  VerticalAlignment="Top" AutomationProperties.AutomationId="ProfileSummary">
        <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate></GroupBox.Template>
        <StackPanel>
        <Border x:Name="ProfileValues" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,8">
          <UniformGrid x:Name="FactsGrid" Columns="4">
          <StackPanel x:Name="ManagerReadingSlot" Style="{StaticResource FactSlot}">
            <TextBlock Text="Manager" Style="{StaticResource FactLabel}"/>
            <Button x:Name="Manager" AutomationProperties.AutomationId="NavigateManager" Click="NavigateManager"
                    Style="{StaticResource QuietButton}" Padding="0" HorizontalContentAlignment="Left" IsEnabled="False">
              <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Button.ContentTemplate>
              <Button.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Content, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></Button.ContextMenu>
            </Button>
          </StackPanel>
          <StackPanel x:Name="OfficeBuildingValueRow" Style="{StaticResource FactSlot}">
            <TextBlock Text="Office building" Style="{StaticResource FactLabel}"/>
            <TextBlock x:Name="OfficeBuildingValue" TextWrapping="Wrap" AutomationProperties.AutomationId="OfficeBuildingValue"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
          </StackPanel>
          <StackPanel x:Name="OfficeNumberValueRow" Style="{StaticResource FactSlot}">
            <TextBlock Text="Office number" Style="{StaticResource FactLabel}"/>
            <TextBlock x:Name="OfficeNumberValue" TextWrapping="Wrap" AutomationProperties.AutomationId="OfficeNumberValue"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
          </StackPanel>
          <StackPanel x:Name="OfficeStateValueRow" Style="{StaticResource FactSlot}">
            <TextBlock Text="Office state / province" Style="{StaticResource FactLabel}"/>
            <TextBlock x:Name="OfficeStateValue" TextWrapping="Wrap" AutomationProperties.AutomationId="OfficeStateValue"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
          </StackPanel>
          <StackPanel x:Name="OfficeCountryValueRow" Style="{StaticResource FactSlot}">
            <TextBlock Text="Office country" Style="{StaticResource FactLabel}"/>
            <TextBlock x:Name="OfficeCountryValue" TextWrapping="Wrap" AutomationProperties.AutomationId="OfficeCountryValue"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
          </StackPanel>
          <StackPanel Style="{StaticResource FactSlot}">
            <TextBlock Text="Directory name" Style="{StaticResource FactLabel}"/>
            <TextBlock x:Name="DirectoryName" AutomationProperties.AutomationId="DirectoryName" TextWrapping="Wrap"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
          </StackPanel>
          <StackPanel x:Name="AliasValueRow" Style="{StaticResource FactSlot}">
            <TextBlock Text="Alias" Style="{StaticResource FactLabel}"/>
            <TextBlock x:Name="AliasValue" TextWrapping="Wrap" AutomationProperties.AutomationId="AliasValue"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
          </StackPanel>
          <StackPanel x:Name="LinkedInProfileUrlValueRow" Style="{StaticResource FactSlot}">
            <TextBlock Text="LinkedIn profile URL" Style="{StaticResource FactLabel}"/>
            <TextBlock x:Name="LinkedInProfileUrlValue" TextWrapping="Wrap" AutomationProperties.AutomationId="LinkedInProfileUrlValue"
                       Focusable="True" KeyboardNavigation.IsTabStop="True">
              <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy value" Tag="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="CopyProfileValue"/></ContextMenu></TextBlock.ContextMenu>
            </TextBlock>
            <Button x:Name="OpenLinkedInButton" Content="Open LinkedIn" IsEnabled="False" Visibility="Collapsed"
                    Style="{StaticResource QuietButton}" Padding="0" HorizontalContentAlignment="Left"
                    AutomationProperties.AutomationId="OpenLinkedIn" Click="OpenLinkedIn"/>
          </StackPanel>
          </UniformGrid>
        </Border>
        <StackPanel x:Name="ProfileForm" Visibility="Collapsed" AutomationProperties.AutomationId="ProfileForm">
          <TextBlock Text="Text, Manager and photo stay in this draft until Save. Empty clears; whitespace alone is invalid."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock x:Name="ProfilePhotoDraft" AutomationProperties.AutomationId="ProfilePhotoDraft"
                     Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
          <StackPanel x:Name="AttributeEditors" IsEnabled="False" Visibility="Collapsed">
            <UniformGrid x:Name="ProfileTextFields" Columns="2" Margin="0,0,-16,0">
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=DirectoryNameEditor}" Content="Directory name" Padding="0,0,0,4"/>
                <TextBox x:Name="DirectoryNameEditor" Tag="DirectoryName" AutomationProperties.AutomationId="DirectoryNameEditor"
                         AutomationProperties.Name="Directory name" TextChanged="EditPersonAttribute"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=Alias}" Content="Alias (short company handle)" Padding="0,0,0,4"/>
                <TextBox x:Name="Alias" Tag="Alias" AutomationProperties.AutomationId="Alias"
                         AutomationProperties.Name="Alias" TextChanged="EditPersonAttribute"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=JobTitle}" Content="Job title" Padding="0,0,0,4"/>
                <TextBox x:Name="JobTitle" Tag="JobTitle" AutomationProperties.AutomationId="JobTitle"
                         AutomationProperties.Name="Job title" TextChanged="EditPersonAttribute"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=Department}" Content="Department" Padding="0,0,0,4"/>
                <TextBox x:Name="Department" Tag="Department" AutomationProperties.AutomationId="Department"
                         AutomationProperties.Name="Department" TextChanged="EditPersonAttribute"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=OfficeBuilding}" Content="Office building" Padding="0,0,0,4"/>
                <TextBox x:Name="OfficeBuilding" Tag="OfficeBuilding" AutomationProperties.AutomationId="OfficeBuilding"
                         AutomationProperties.Name="Office building" TextChanged="EditPersonAttribute"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=OfficeNumber}" Content="Office number" Padding="0,0,0,4"/>
                <TextBox x:Name="OfficeNumber" Tag="OfficeNumber" AutomationProperties.AutomationId="OfficeNumber"
                         AutomationProperties.Name="Office number" TextChanged="EditPersonAttribute"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=OfficeState}" Content="Office state / province" Padding="0,0,0,4"/>
                <TextBox x:Name="OfficeState" Tag="OfficeState" AutomationProperties.AutomationId="OfficeState"
                         AutomationProperties.Name="Office state" TextChanged="EditPersonAttribute"/>
              </StackPanel>
              <StackPanel Style="{StaticResource ProfileField}">
                <Label Target="{Binding ElementName=OfficeCountry}" Content="Office country" Padding="0,0,0,4"/>
                <TextBox x:Name="OfficeCountry" Tag="OfficeCountry" AutomationProperties.AutomationId="OfficeCountry"
                         AutomationProperties.Name="Office country" TextChanged="EditPersonAttribute"/>
              </StackPanel>
            </UniformGrid>
            <Label Target="{Binding ElementName=LinkedInProfileUrl}" Content="LinkedIn profile URL" Padding="0,0,0,4"/>
            <TextBox x:Name="LinkedInProfileUrl" Tag="LinkedInProfileUrl" AutomationProperties.AutomationId="LinkedInProfileUrl"
                     AutomationProperties.Name="LinkedIn profile URL" TextChanged="EditPersonAttribute"/>
            <TextBlock Text="HTTPS only; never fetched automatically." Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,4"/>
          </StackPanel>
          <StackPanel x:Name="LinkedInEditLink"/>
          <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,12">
            <StackPanel>
            <StackPanel x:Name="ManagerEditor" IsEnabled="False" Visibility="Collapsed">
              <Label Target="{Binding ElementName=ManagerChoices}" Content="Manager" Padding="0,0,0,4"/>
              <ComboBox x:Name="ManagerChoices" DisplayMemberPath="Label" AutomationProperties.AutomationId="ManagerChoice"
                        AutomationProperties.Name="Manager in this profile draft" Padding="6,4"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True" SelectionChanged="StagePersonManager">
                <ComboBox.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                  </Style>
                </ComboBox.ItemContainerStyle>
              </ComboBox>
              <Button Content="Stage Manager change" AutomationProperties.AutomationId="ApplyManagerChange"
                      Click="ChangePersonManager" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <TextBlock Text="No inferred report changes." Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock Text="Saved Manager" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
            <StackPanel x:Name="ManagerEditLink"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock x:Name="ReportCount" Text="Imported reports (not a full-company count)" TextWrapping="Wrap"/>
        <ListBox x:Name="ReportsList" AutomationProperties.AutomationId="ImportedReports" DisplayMemberPath="Heading"
                 SelectionChanged="NavigateReport" MaxHeight="110" Margin="0,4,0,12"/>
        </StackPanel>
        </GroupBox>
        <GroupBox x:Name="NotesPane" Grid.Row="1" BorderThickness="0" Padding="0"
                  VerticalAlignment="Top" AutomationProperties.AutomationId="NotesPane">
        <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter/></ControlTemplate></GroupBox.Template>
        <StackPanel>
        <GroupBox x:Name="SearchContextPanel" Header="Selected search context — separate from the current profile" Visibility="Collapsed" Margin="0,0,0,12">
          <StackPanel Margin="8">
            <Button Content="Close search context" AutomationProperties.AutomationId="CloseSearchContext"
                    Click="CloseSearchContext" HorizontalAlignment="Right"/>
            <TextBlock x:Name="SearchContextText" AutomationProperties.AutomationId="SearchContext" TextWrapping="Wrap"
                       Focusable="True" KeyboardNavigation.IsTabStop="False"/>
            <FlowDocumentScrollViewer x:Name="SearchResultReading" AutomationProperties.AutomationId="SearchResultReading"/>
          </StackPanel>
        </GroupBox>
        <local:PersonNotesControl x:Name="PersonNotes" AutomationProperties.AutomationId="PersonNotesSurface" Margin="0,16,0,0"/>
        <local:TeamNotesControl x:Name="TeamNotes" AutomationProperties.AutomationId="TeamNotesSurface" Margin="0,16,0,0"/>
        <Expander x:Name="HistoryAccess" Header="History" AutomationProperties.AutomationId="HistoryAccess" Margin="0,16,0,0">
        <StackPanel>
        <GroupBox Margin="0,16,0,0">
          <GroupBox.Header>
            <TextBlock Text="Structured Profile timeline — most recent recording first" TextWrapping="Wrap"/>
          </GroupBox.Header>
          <TextBlock x:Name="ProfileTimelineText" AutomationProperties.AutomationId="ProfileTimeline"
                     Text="Select a Person to review Profile changes." TextWrapping="Wrap" Margin="8"/>
        </GroupBox>
        <Expander Header="Field-specific confirmations" Margin="0,8,0,0" IsExpanded="True">
          <TextBlock x:Name="FieldConfirmationsText" AutomationProperties.AutomationId="FieldConfirmations"
                     TextWrapping="Wrap" Margin="8"/>
        </Expander>
        <Expander Margin="0,8,0,0" IsExpanded="True">
          <Expander.Header>
            <TextBlock Text="Source observations and local recordings" TextWrapping="Wrap"/>
          </Expander.Header>
          <TextBlock x:Name="ProfileObservationsText" AutomationProperties.AutomationId="ProfileObservations"
                     TextWrapping="Wrap" Margin="8"/>
        </Expander>
        <GroupBox Margin="0,16,0,0">
          <GroupBox.Header>
            <TextBlock Text="Historical team context — frozen former context, not current inheritance" TextWrapping="Wrap"/>
          </GroupBox.Header>
          <StackPanel Margin="8">
            <TextBlock x:Name="HistoricalTeamSummary" AutomationProperties.AutomationId="HistoricalTeamSummary"
                       Text="Select a Person to review Historical team context." TextWrapping="Wrap"/>
            <TextBlock Text="Frozen Team-note reading — read-only, attributable local captures" Margin="0,8,0,4" TextWrapping="Wrap"/>
            <FlowDocumentScrollViewer x:Name="HistoricalTeamReading" AutomationProperties.AutomationId="HistoricalTeamReading"
                                      AutomationProperties.Name="Historical frozen Team notes; never current inheritance"/>
          </StackPanel>
        </GroupBox>
        </StackPanel>
        </Expander>
        </StackPanel>
        </GroupBox>
        </Grid>
      </StackPanel>
      </ScrollViewer>
      </Grid>
      <Button x:Name="PeopleDismissSurface" Grid.ColumnSpan="3" Panel.ZIndex="10" Visibility="Collapsed"
              Background="#33000000" BorderThickness="0" Focusable="False" IsTabStop="False"
              AutomationProperties.Name="Close People overlay" Click="ClosePeople"/>
    </Grid>
    </GroupBox>
    <GroupBox x:Name="OperationalNotice" Grid.Row="1" Visibility="Collapsed" Background="#FFF4DC"
            BorderBrush="#E6D3AB" BorderThickness="0,1" Padding="12,8" Margin="0,0,0,12"
            AutomationProperties.AutomationId="OperationalNotice" AutomationProperties.Name="Workspace notice">
    <GroupBox.Template>
      <ControlTemplate TargetType="GroupBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
      </ControlTemplate>
    </GroupBox.Template>
    <StackPanel>
      <DockPanel>
        <Button x:Name="NoticeRecoveryButton" Content="Settings" DockPanel.Dock="Right"
                AutomationProperties.AutomationId="NoticeRecovery" Click="OpenRecoverySettings"
                Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
        <Button x:Name="NoticeRetryButton" Content="Retry" DockPanel.Dock="Right" Visibility="Collapsed"
                AutomationProperties.AutomationId="NoticeRetry" Click="RetryWorkspace" Style="{StaticResource QuietButton}"/>
        <TextBlock x:Name="NoticeSummary" AutomationProperties.AutomationId="NoticeSummary" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
      </DockPanel>
      <WrapPanel>
        <Button x:Name="DiscardImportButton" Content="Discard failed Import (not other drafts)" Click="DiscardImportChanges"
                AutomationProperties.AutomationId="DiscardImport" Visibility="Collapsed" IsEnabled="False" Margin="0,4,8,0"/>
        <Button x:Name="RetryProfileButton" Content="Retry unsaved profile / quick action" Click="RetryProfileSave"
                AutomationProperties.AutomationId="RetryProfileSave" Visibility="Collapsed" IsEnabled="False" Margin="0,4,0,0"/>
        <Button x:Name="DiscardProfileButton" Content="Discard profile / quick draft (not notes)" Click="DiscardProfileDraft"
                AutomationProperties.AutomationId="DiscardProfileDraft" Visibility="Collapsed" IsEnabled="False" Margin="8,4,0,0"/>
      </WrapPanel>
      <Expander x:Name="OperationalDetails" Header="Details" AutomationProperties.AutomationId="OperationalDetails"
                IsExpanded="False" Margin="0,4,0,0">
      <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
      <TextBlock x:Name="WorkflowActivity" AutomationProperties.AutomationId="WorkflowActivity" Text="Ready">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A3B12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
              <Trigger Property="Text" Value="Ready">
                <Setter Property="Foreground" Value="DimGray"/>
                <Setter Property="FontWeight" Value="Normal"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="WorkspaceFreshness" AutomationProperties.AutomationId="WorkspaceFreshness" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A3B12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
              <Trigger Property="Text" Value="Current validated local Workspace.">
                <Setter Property="Foreground" Value="DimGray"/>
                <Setter Property="FontWeight" Value="Normal"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="LocalWritingDetails" TextWrapping="Wrap"/>
      <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="Status" TextWrapping="Wrap" Text="Choose a Workspace.">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A3B12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
              <Trigger Property="Text" Value="Workspace opened.">
                <Setter Property="Foreground" Value="DimGray"/>
                <Setter Property="FontWeight" Value="Normal"/>
              </Trigger>
              <Trigger Property="Text" Value="Saved locally.">
                <Setter Property="Foreground" Value="DimGray"/>
                <Setter Property="FontWeight" Value="Normal"/>
              </Trigger>
              <Trigger Property="Text" Value="Profile saved locally.">
                <Setter Property="Foreground" Value="DimGray"/>
                <Setter Property="FontWeight" Value="Normal"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      </StackPanel>
      </ScrollViewer>
      </Expander>
    </StackPanel>
    </GroupBox>
  </Grid>
</Window>
