<UserControl x:Class="OrgExplorer.Desktop.PersonNotesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{DynamicResource ReadingSection}">
  <StackPanel>
    <DockPanel LastChildFill="True">
      <Button x:Name="NewButton" Content="New Person note" DockPanel.Dock="Right" Style="{DynamicResource QuietButton}"
              AutomationProperties.AutomationId="NewPersonNote" Click="CreateNote" IsEnabled="False"/>
      <TextBlock Text="Person notes" Style="{DynamicResource ReadingHeading}"/>
    </DockPanel>
    <TextBlock x:Name="Ownership" AutomationProperties.AutomationId="PersonNoteOwnership"
               Style="{DynamicResource NoteMetadata}"/>
    <TextBlock x:Name="OngoingStatus" AutomationProperties.AutomationId="PersonOngoingNoteStatus"
               Style="{DynamicResource ReadingProse}" Foreground="#9C3B10"/>
    <WrapPanel>
      <Button x:Name="OngoingButton" Content="Open ongoing note" Style="{DynamicResource QuietButton}"
              AutomationProperties.AutomationId="OpenOngoingPersonNote" Click="OpenOngoing" Visibility="Collapsed"/>
    </WrapPanel>
    <Expander x:Name="OtherNotes" Header="Other notes" AutomationProperties.AutomationId="OtherPersonNotes"
              Style="{DynamicResource ReadingDisclosure}" Expanded="ChangeOtherNotes" Collapsed="ChangeOtherNotes">
      <StackPanel>
        <TextBlock Text="Open any separately titled note, then choose Use as ongoing to change your continuing document."
                   Style="{DynamicResource NoteMetadata}"/>
        <CheckBox x:Name="IncludeArchived" Content="Show archived notes"
                AutomationProperties.AutomationId="ShowArchivedPersonNotes"
                Checked="ChangeArchiveFilter" Unchecked="ChangeArchiveFilter" VerticalAlignment="Center"/>
        <ListBox x:Name="NotesList" AutomationProperties.AutomationId="PersonNotes" AutomationProperties.Name="Person notes"
             DisplayMemberPath="Title" MaxHeight="160" SelectionChanged="SelectNote"
             BorderThickness="0" Background="Transparent" ItemContainerStyle="{DynamicResource OtherNoteItem}">
        </ListBox>
      </StackPanel>
    </Expander>
    <TextBlock x:Name="EmptyNotes" AutomationProperties.AutomationId="PersonNotesEmpty"
               Text="No Person notes yet. Keep private context about this Person."
               Style="{DynamicResource NoteMetadata}" Visibility="Collapsed"/>
    <TextBlock x:Name="NoteHeading" AutomationProperties.AutomationId="PersonNoteHeading"
               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <WrapPanel>
      <TextBlock x:Name="NoteKind" AutomationProperties.AutomationId="PersonNoteKind"
                 Style="{DynamicResource NoteMetadata}" VerticalAlignment="Center"/>
      <Button x:Name="DesignateButton" Content="Use as ongoing" Margin="8,0,0,0" Visibility="Collapsed"
              Style="{DynamicResource QuietButton}" AutomationProperties.AutomationId="UseAsOngoingPersonNote" Click="DesignateOngoing"/>
    </WrapPanel>
    <TabControl x:Name="Views" Margin="0,8,0,0" BorderThickness="0" Padding="0" Background="Transparent"
                HorizontalContentAlignment="Stretch" Visibility="Collapsed" SelectionChanged="ChangeNoteMode">
      <TabItem x:Name="ReadTab" Header="Read" AutomationProperties.AutomationId="PersonNoteReadTab" Style="{DynamicResource NoteModeTab}">
        <StackPanel>
          <TextBlock x:Name="EmptyBody" AutomationProperties.AutomationId="PersonNoteEmptyBody"
                     Style="{DynamicResource NoteMetadata}" Visibility="Collapsed"/>
          <FlowDocumentScrollViewer x:Name="Reading" AutomationProperties.AutomationId="PersonNoteReading"
                                    AutomationProperties.HelpText="Images and raw HTML are never loaded. External links open only when selected."/>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="EditTab" Header="Edit" AutomationProperties.AutomationId="PersonNoteEditTab" Style="{DynamicResource NoteModeTab}">
        <StackPanel>
          <TextBlock Text="Title (autosaved)" Margin="0,0,0,4"/>
          <TextBox x:Name="NoteTitle" AutomationProperties.AutomationId="PersonNoteTitle"
                   AutomationProperties.Name="Person note title" IsEnabled="False" TextChanged="EditNote"/>
          <TextBlock Text="Markdown (autosaved)" Margin="0,8,0,4"/>
          <TextBox x:Name="MarkdownEditor" AutomationProperties.AutomationId="PersonNoteMarkdown"
                   AutomationProperties.Name="Person note Markdown"
                   IsEnabled="False" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                   TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" TextChanged="EditNote"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <WrapPanel Margin="0,8,0,0">
      <Button x:Name="ArchiveButton" Content="Archive note" AutomationProperties.AutomationId="ArchivePersonNote"
              Style="{DynamicResource QuietButton}" Click="ArchiveNote" IsEnabled="False"/>
      <Button x:Name="RetryButton" Content="Retry local save" AutomationProperties.AutomationId="RetryPersonNoteSave"
              Click="RetrySave" IsEnabled="False" Margin="0,0,8,0"/>
      <Button x:Name="DiscardButton" Content="Discard unsaved draft" AutomationProperties.AutomationId="DiscardPersonNoteDraft"
              Click="DiscardDraft" IsEnabled="False" Margin="0,0,8,0"/>
    </WrapPanel>
      <TextBlock x:Name="NoteStatus" AutomationProperties.AutomationId="PersonNoteStatus"
                 Style="{DynamicResource ReadingProse}" VerticalAlignment="Center" Visibility="Collapsed"/>
  </StackPanel>
  </Border>
</UserControl>
