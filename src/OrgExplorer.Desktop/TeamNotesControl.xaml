<UserControl x:Class="OrgExplorer.Desktop.TeamNotesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
  <Border Style="{DynamicResource ReadingSection}">
  <StackPanel>
    <DockPanel LastChildFill="True">
      <Button x:Name="NewButton" Content="New Team note" DockPanel.Dock="Right" Style="{DynamicResource QuietButton}"
              AutomationProperties.AutomationId="NewTeamNote" Click="CreateNote" IsEnabled="False"/>
      <TextBlock Text="Owned Team notes" Style="{DynamicResource ReadingHeading}"/>
    </DockPanel>
    <TextBlock x:Name="Ownership" AutomationProperties.AutomationId="TeamNoteOwnership"
               AutomationProperties.HelpText="Ownership stays with this Person, not a permanent team. Team scope is not sharing."
               ToolTip="Ownership stays with this Person, not a permanent team. Team scope is not sharing."
               Style="{DynamicResource NoteMetadata}"/>
    <TextBlock x:Name="OngoingStatus" AutomationProperties.AutomationId="TeamOngoingNoteStatus"
               Style="{DynamicResource ReadingProse}" Foreground="#9C3B10"/>
    <TextBlock x:Name="OwnedReviewWarnings" AutomationProperties.AutomationId="OwnedTeamReviewWarnings"
               Style="{DynamicResource ReadingProse}" Foreground="#9C3B10" FontWeight="SemiBold"/>
    <WrapPanel>
      <Button x:Name="OngoingButton" Content="Open ongoing note" Style="{DynamicResource QuietButton}"
              AutomationProperties.AutomationId="OpenOngoingTeamNote" Click="OpenOngoing" Visibility="Collapsed"/>
    </WrapPanel>
    <Expander x:Name="OtherNotes" Header="Other notes" AutomationProperties.AutomationId="OtherTeamNotes"
              Style="{DynamicResource ReadingDisclosure}" Expanded="ChangeOtherNotes" Collapsed="ChangeOtherNotes">
      <StackPanel>
        <TextBlock Text="Open any owned Team note, then choose Use as ongoing. Every active Team note still supplies context to formal descendants."
                   Style="{DynamicResource NoteMetadata}"/>
        <CheckBox x:Name="IncludeArchived" Content="Show archived Team notes"
                AutomationProperties.AutomationId="ShowArchivedTeamNotes"
                Checked="ChangeArchiveFilter" Unchecked="ChangeArchiveFilter" VerticalAlignment="Center"/>
        <ListBox x:Name="NotesList" AutomationProperties.AutomationId="TeamNotes" AutomationProperties.Name="Owned Team notes"
                 DisplayMemberPath="Title" MaxHeight="160" SelectionChanged="SelectNote"
                 BorderThickness="0" Background="Transparent" ItemContainerStyle="{DynamicResource OtherNoteItem}">
        </ListBox>
      </StackPanel>
    </Expander>
    <TextBlock x:Name="EmptyNotes" AutomationProperties.AutomationId="TeamNotesEmpty"
               Text="No owned Team notes yet. Record context for formal descendants."
               Style="{DynamicResource NoteMetadata}" Visibility="Collapsed"/>
    <TextBlock x:Name="ReviewStatus" AutomationProperties.AutomationId="TeamNoteReview"
               Style="{DynamicResource ReadingProse}" FontWeight="SemiBold"/>
    <TextBlock x:Name="NoteHeading" AutomationProperties.AutomationId="TeamNoteHeading"
               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <WrapPanel>
      <TextBlock x:Name="NoteKind" AutomationProperties.AutomationId="TeamNoteKind"
                 Style="{DynamicResource NoteMetadata}" VerticalAlignment="Center"/>
      <Button x:Name="DesignateButton" Content="Use as ongoing" Margin="8,0,0,0" Visibility="Collapsed"
              Style="{DynamicResource QuietButton}" AutomationProperties.AutomationId="UseAsOngoingTeamNote" Click="DesignateOngoing"/>
    </WrapPanel>
    <TabControl x:Name="Views" Margin="0,8,0,0" BorderThickness="0" Padding="0" Background="Transparent"
                HorizontalContentAlignment="Stretch" Visibility="Collapsed" SelectionChanged="ChangeNoteMode">
      <TabItem x:Name="ReadTab" Header="Read" AutomationProperties.AutomationId="TeamNoteReadTab" Style="{DynamicResource NoteModeTab}">
        <StackPanel>
          <TextBlock x:Name="EmptyBody" AutomationProperties.AutomationId="TeamNoteEmptyBody"
                     Style="{DynamicResource NoteMetadata}" Visibility="Collapsed"/>
          <FlowDocumentScrollViewer x:Name="Reading" AutomationProperties.AutomationId="TeamNoteReading"
                                    AutomationProperties.HelpText="Images and raw HTML are never loaded. External links open only when selected."/>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="EditTab" Header="Edit" AutomationProperties.AutomationId="TeamNoteEditTab" Style="{DynamicResource NoteModeTab}">
        <StackPanel>
          <TextBlock Text="Title (autosaved; editing confirms current applicability)" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBox x:Name="NoteTitle" AutomationProperties.AutomationId="TeamNoteTitle"
                   AutomationProperties.Name="Team note title" IsEnabled="False" TextChanged="EditNote"/>
          <TextBlock Text="Markdown (autosaved)" Margin="0,8,0,4"/>
          <TextBox x:Name="MarkdownEditor" AutomationProperties.AutomationId="TeamNoteMarkdown"
                   AutomationProperties.Name="Team note Markdown"
                   IsEnabled="False" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                   TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" TextChanged="EditNote"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <WrapPanel Margin="0,8">
      <Button x:Name="ConfirmButton" Content="Confirm still applies" AutomationProperties.AutomationId="ConfirmTeamNote"
              Click="ConfirmNote" IsEnabled="False" Margin="0,0,8,0"/>
      <Button x:Name="ArchiveButton" Content="Archive Team note" AutomationProperties.AutomationId="ArchiveTeamNote"
              Style="{DynamicResource QuietButton}" Click="ArchiveNote" IsEnabled="False" Margin="0,0,8,0"/>
      <Button x:Name="RetryButton" Content="Retry local save" AutomationProperties.AutomationId="RetryTeamNoteSave"
              Click="RetrySave" IsEnabled="False" Margin="0,0,8,0"/>
      <Button x:Name="DiscardButton" Content="Discard unsaved draft" AutomationProperties.AutomationId="DiscardTeamNoteDraft"
              Click="DiscardDraft" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock x:Name="NoteStatus" AutomationProperties.AutomationId="TeamNoteStatus" Style="{DynamicResource ReadingProse}"/>
  </StackPanel>
  </Border>
  <Border Style="{DynamicResource ReadingSection}">
  <StackPanel>
    <TextBlock x:Name="InheritedReviewWarnings" AutomationProperties.AutomationId="InheritedTeamReviewWarnings"
               Style="{DynamicResource ReadingProse}" Foreground="#9C3B10" FontWeight="SemiBold"/>
    <Expander x:Name="CurrentTeamContext"
              AutomationProperties.AutomationId="CurrentTeamContext" Style="{DynamicResource ReadingDisclosure}">
      <Expander.Header>
        <TextBlock x:Name="ContextHeading" Text="Current inherited Team context" Style="{DynamicResource ReadingHeading}"/>
      </Expander.Header>
      <StackPanel>
        <TextBlock x:Name="InheritedSummary" AutomationProperties.AutomationId="InheritedTeamSummary" Style="{DynamicResource NoteMetadata}"/>
        <StackPanel x:Name="ReviewOwners" Margin="0,4"/>
        <FlowDocumentScrollViewer x:Name="InheritedReading" AutomationProperties.AutomationId="InheritedTeamReading"/>
      </StackPanel>
    </Expander>
    <TextBlock x:Name="ContextAttribution" AutomationProperties.AutomationId="CurrentTeamAttribution"
               Style="{DynamicResource NoteMetadata}"/>
  </StackPanel>
  </Border>
  </StackPanel>
</UserControl>
