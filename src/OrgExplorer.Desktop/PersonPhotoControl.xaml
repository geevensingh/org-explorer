<UserControl x:Class="OrgExplorer.Desktop.PersonPhotoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Left" Margin="0,8,0,0">
    <Grid>
      <Image x:Name="PhotoImage" AutomationProperties.AutomationId="PersonPhoto"
             Width="96" Height="96" Stretch="Uniform" Visibility="Collapsed"/>
      <TextBlock x:Name="Placeholder" AutomationProperties.AutomationId="PhotoPlaceholder"
                 Text="Photo unavailable" Foreground="DimGray"/>
    </Grid>
    <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="False">
      <Button Content="Choose photo…" AutomationProperties.AutomationId="ChoosePhoto" Click="ChoosePhoto"/>
      <Button Content="Clear photo" AutomationProperties.AutomationId="ClearPhoto" Margin="8,0,0,0" Click="ClearPhoto"/>
    </StackPanel>
  </StackPanel>
</UserControl>
