<UserControl x:Class="OrgExplorer.Desktop.PersonPhotoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Left">
    <Grid Width="144" Height="144" HorizontalAlignment="Left">
      <!-- UniformToFill can arrange oversized image ink; clip the fixed viewport instead. -->
      <Grid.Clip><EllipseGeometry Center="72,72" RadiusX="72" RadiusY="72"/></Grid.Clip>
      <Ellipse Fill="#214B79"/>
      <Image x:Name="PhotoImage" AutomationProperties.AutomationId="PersonPhoto"
             Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
             Visibility="Collapsed"/>
      <TextBlock x:Name="Placeholder" AutomationProperties.AutomationId="PhotoPlaceholder"
                 Text="?" FontSize="51.4285714286" FontWeight="SemiBold" Foreground="White"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
    <WrapPanel x:Name="Actions" MaxWidth="132" Margin="0,6,0,0" IsEnabled="False" Visibility="Collapsed">
      <Button Content="Choose photo…" AutomationProperties.AutomationId="ChoosePhoto" Click="ChoosePhoto"/>
      <Button Content="Clear photo" AutomationProperties.AutomationId="ClearPhoto" Margin="0,4,0,0" Click="ClearPhoto"/>
    </WrapPanel>
  </StackPanel>
</UserControl>
