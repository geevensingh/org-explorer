<UserControl x:Class="OrgExplorer.Desktop.PersonPhotoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Left" Width="126">
    <Grid Height="96">
      <Image x:Name="PhotoImage" AutomationProperties.AutomationId="PersonPhoto"
             Width="96" Height="96" Stretch="Uniform" Visibility="Collapsed"/>
      <TextBlock x:Name="Placeholder" AutomationProperties.AutomationId="PhotoPlaceholder"
                 Text="Photo unavailable" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="DimGray"/>
    </Grid>
    <WrapPanel x:Name="Actions" Margin="0,6,0,0" IsEnabled="False" Visibility="Collapsed">
      <Button Content="Choose photo…" AutomationProperties.AutomationId="ChoosePhoto" Click="ChoosePhoto"/>
      <Button Content="Clear photo" AutomationProperties.AutomationId="ClearPhoto" Margin="0,4,0,0" Click="ClearPhoto"/>
    </WrapPanel>
  </StackPanel>
</UserControl>
