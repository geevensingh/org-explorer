<UserControl x:Class="OrgExplorer.Desktop.PersonPhotoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel HorizontalAlignment="Left">
    <Grid Width="56" Height="56" HorizontalAlignment="Left">
      <Ellipse Fill="#214B79"/>
      <Image x:Name="PhotoImage" AutomationProperties.AutomationId="PersonPhoto"
             Width="56" Height="56" Stretch="UniformToFill" Visibility="Collapsed">
        <Image.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/></Image.Clip>
      </Image>
      <TextBlock x:Name="Placeholder" AutomationProperties.AutomationId="PhotoPlaceholder"
                 Text="?" FontSize="20" FontWeight="SemiBold" Foreground="White"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
    <WrapPanel x:Name="Actions" Margin="0,6,0,0" IsEnabled="False" Visibility="Collapsed">
      <Button Content="Choose photo…" AutomationProperties.AutomationId="ChoosePhoto" Click="ChoosePhoto"/>
      <Button Content="Clear photo" AutomationProperties.AutomationId="ClearPhoto" Margin="0,4,0,0" Click="ClearPhoto"/>
    </WrapPanel>
  </StackPanel>
</UserControl>
