<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\DesktopScenarios.json" Link="DesktopScenarios.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\UiScaleScenarios.json" Link="UiScaleScenarios.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\WorkspaceFixtures.cs" Link="WorkspaceFixtures.cs" />
    <Compile Include="..\ScaleFixture.cs" Link="ScaleFixture.cs" />
    <Content Include="..\Fixtures\**\*" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\OrgExplorer.Workflow\OrgExplorer.Workflow.csproj"/>
  </ItemGroup>
</Project>
